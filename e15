cd "/Users/shelbyprue/Desktop/AI Evals Course/cartwheel-homeworks"
mkdir -p eval_results
caffeinate -i nohup .venv/bin/python scripts/run_ci_local.py \
  --job-name hw6-capability-15 \
  --case e-009 \
  --n-attempts 15 \
  --model openai/rl-muse-spark-1-1-playground > .hw6-logs/e15.log 2>&1 &
disown
echo "started: e-009 x 15 runs, ~45 min"
echo "when done: ./e15analyze"
