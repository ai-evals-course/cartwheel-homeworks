# Copy this file to .env and fill in the keys you have. Any one model key is
# enough to chat with the agent.

# OpenAI key. Used by the default course model, gpt-5.5.
OPENAI_API_KEY=

# Anthropic key. Used by claude-opus-4-6, routed through LiteLLM.
ANTHROPIC_API_KEY=

# Together AI key. Used by GLM 5.2, routed through LiteLLM as together_ai/zai-org/GLM-5.2.
TOGETHER_API_KEY=

# Default model for the CLI and the server. One of: gpt-5.5, claude-opus-4-6, glm-5.2.
CARTWHEEL_MODEL=gpt-5.5

# Langfuse project keys. These defaults match the LANGFUSE_INIT_* values in
# observability/docker-compose.yml, so the self-hosted stack works out of the box.
LANGFUSE_PUBLIC_KEY=pk-lf-cartwheel-dev
LANGFUSE_SECRET_KEY=sk-lf-cartwheel-dev

# Base URL of the self-hosted Langfuse stack.
LANGFUSE_HOST=http://localhost:3000

# Opt in to message and tool content for the fictional course data.
# Use false when content must not be recorded; redact before export.
TRACELOOP_TRACE_CONTENT=true

# Dev-only secret that signs session tokens in server/app.py. Not real auth.
CARTWHEEL_DEV_SECRET=cartwheel-dev-secret

# Google Gemini key, required when a registered DocETL judge uses a Gemini model.
GEMINI_API_KEY=

# HW4 Part C: local Raindrop Workshop daemon (raindrop workshop status).
# Auto-detection isn't reliable, so this is set explicitly.
RAINDROP_LOCAL_DEBUGGER=http://localhost:5899/v1/

# HW5: the LLM judge model. The handout specifies gpt-4o-mini as the
# baseline (dev and test must use the same model) -- exposed as an env var
# so it's easy to swap for experimentation without editing run_judges.py.
CARTWHEEL_JUDGE_MODEL=gpt-4o-mini
