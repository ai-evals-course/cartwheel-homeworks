{"scenario_id": "support-0034", "scenario_group": "coverage", "model": "gpt-5.5", "status": "completed", "error": null, "turns": [{"user": "What is Cartwheel's standard return window?", "agent": "Cartwheel\u2019s standard return window is **30 days from the delivery date**, not the purchase date. Some individual stores may have different return windows. (Policy: **cw-returns**)"}], "expected": {"evaluation": "objective", "outcome": "state_platform_30_day_window", "reason": "Platform return window is 30 days from delivery.", "source": {"type": "policy_document", "reference": "cw-returns"}}, "duration_s": 3.9}
